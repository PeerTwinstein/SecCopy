[Unit]
Description=SecureCopy repository server
Documentation=file:///usr/share/doc/seccopy-server/Nutzung.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/seccopy/server.env
ExecStart=/usr/lib/seccopy/seccopy-server.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
