# Kopieren nach /etc/seccopy/server.env und anpassen.
# Der öffentliche APT-Spiegel-Schlüssel muss für den Dienst-User
# in GnuPG liegen (GNUPGHOME oder Default-Keyring).

SECCOPY_GPG_USER=
SECCOPY_ROOT=/srv/seccopy
SECCOPY_LISTEN=127.0.0.1:50051
SECCOPY_REPO=default

# Optional:
# SECCOPY_GPG=gpg
# SECCOPY_MAX_READS=256
# SECCOPY_USER=
# SECCOPY_PASSWORD=
# GNUPGHOME=/var/lib/seccopy/.gnupg
